@using Online_Food_Portal.Models
@model OrderDTO

@{
    ViewData["Title"] = "Order View";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div>
    <div class="card" style="width: 90%; margin-left: auto; margin-right: auto;">
        <div class="card-body">
            <h4 class="card-title">@Model.order.id</h4>
            @if (Model.items.Count == 0)
            {
                <h4>No Orders To Display</h4>
            }
            @foreach (OrderItemDTO orderItemDTO in Model.items)
            {
                <h5 class="card-title">@orderItemDTO.Display</h5>
                @foreach (OrderModificationModel modificationModel in orderItemDTO.OrderModificationModels)
                {
                    <p class="card-text">@modificationModel.modificationModel.name</p>
                }
            }
            @if (Model.order.cancelled)
            {
                <a href="/Kitchen/Home" class="btn btn-primary">Order Cancelled, Return</a>
            }
            else
            {
                if (!Model.order.completed)
                {
                    <a href="/Kitchen/CompleteOrder/@Model.order.id" class="btn btn-primary">Complete</a>
                }
                else
                {
                    if (!Model.order.picked_up)
                    {
                        <a href="/Kitchen/CompleteOrder/@Model.order.id" class="btn btn-secondary">Undo Complete</a>
                        <a href="/Kitchen/PickupOrder/@Model.order.id" class="btn btn-primary">Order Picked Up</a>
                    }
                    else
                    {
                        <a href="/Kitchen/PickupOrder/@Model.order.id" class="btn btn-secondary">Undo Order Picked Up</a>
                    }
                }
                <a onclick="CancelOrder(@Model.order.id);" class="btn btn-danger">Cancel</a>
            }
        </div>
    </div>
</div>

<script>
    function CancelOrder(orderId)
    {
        if (confirm("Are you sure you wish to cancel this order?"))
        {
            window.location.href = window.location.origin + '/Kitchen/CancelOrder/' + orderId;
        }
    }
</script>