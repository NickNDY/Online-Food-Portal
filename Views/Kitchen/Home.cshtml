@using Online_Food_Portal.Models
@model IEnumerable<OrderDTO>

@{
    ViewData["Title"] = "Order View";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="d-flex flex-column">
    @foreach (OrderDTO orderDTO in Model)
    {
        <div class="card" style="width: 90%; margin-left: auto; margin-right: auto;">
            <div class="card-body">
                <h4 class="card-title">@orderDTO.order.id</h4>
                @foreach (OrderItemDTO orderItemDTO in orderDTO.items)
                {
                    <h5 class="card-title">@orderItemDTO.Display</h5>
                    @foreach (OrderModificationModel modificationModel in orderItemDTO.OrderModificationModels)
                    {
                        <p class="card-text">@modificationModel.modificationModel.name</p>
                    }
                }
                <a href="/Kitchen/OrderSelect/@orderDTO.order.id" class="btn btn-primary">Select</a>
            </div>
        </div>
    }
</div>