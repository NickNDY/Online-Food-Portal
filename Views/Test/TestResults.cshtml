<div id="testResults">
    @{int index = 0;}
    @foreach(string result in ViewBag.results)
    {
        if (index == 0)
        {
            if (result.EndsWith("Pass"))
            {
                <h2 style="color: green">@result</h2>
            }
            else
            {
                <h2 style="color: red">@result</h2>
            }
        }
        else if (result.Length == 0)
        {
            <hr />
        }
        else if (result.StartsWith("--"))
        {
            <h3 style="color: purple">@result</h3>
        }
        else if (result.EndsWith("Fail"))
        {
            <p style="color: red">@result</p>
        }
        else if (result.EndsWith("Pass"))
        {
            <p style="color: green">@result</p>
        }
        else
        {
            <p>@result</p>
        }
        index++;
    }
</div>