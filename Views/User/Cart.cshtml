@using Online_Food_Portal.Models
@model OrderDTO

@{
    ViewData["Title"] = "Cart";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div style="width: 95%; margin-right: auto; margin-left: auto;">
    @foreach (OrderItemDTO orderItem in Model.items)
    {
        <div id=@($"orderItem{orderItem.OrderItemModel.id}") class="d-inline-flex" style="width: 100%; padding-top: 15px; border: 1px solid black; border-radius: 5px;">
            <div class="d-inline-flex" style="width: 85%; height: 100%;">
                <div style="width: 80%; height: 100%;">
                    <h5>@orderItem.Display</h5>
                    @foreach (OrderModificationModel modification in orderItem.OrderModificationModels)
                    {
                        <p>@($"{modification.modificationModel.name} ${modification.modificationModel.price_offset}")</p>
                    }
                </div>
                <div class="flex-column" style="width: 20%; height: 100%;">
                    <button style="width: 100%; border-radius: 6px;" onclick="window.location.href='/User/ItemModification?orderItemId=@orderItem.OrderItemModel.id'" class="btn-primary">Modify</button>
                    <button style="width: 100%; border-radius: 6px;" onclick="RemoveItem(@orderItem.OrderItemModel.id);" class="btn-danger">Remove</button>
                </div>
            </div>
            <div style="width: 15%; height: 100%; border: 1px solid black;">
                <p>$@orderItem.OrderItemModel.itemModel.price.ToString("0.00")</p>
            </div>
        </div>
    }
</div>

<script>
    function RemoveItem(itemId)
    {
        console.log("Removing order item: " + itemId);

        var element = document.getElementById("orderItem" + itemId);
        if (element)
        {
            element.parentNode.removeChild(element);
        }

        let url = window.location.origin + "/api/User/RemoveItemFromOrder";

        const payload = { value: itemId };

        fetch(url,
        {
            method: "DELETE",
            credentials: 'same-origin',
            body: JSON.stringify(payload),
            headers: {
                "Content-Type": "application/json",
                "Host": window.location.host
            }
        });
    }
</script>